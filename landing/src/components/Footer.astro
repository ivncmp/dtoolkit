---
const footerLink = 'text-sm text-[var(--text-3)] hover:text-brand-purple transition-colors';
---

<footer class="border-t border-[var(--border-subtle)] py-16">
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10">
      <div>
        <div class="flex items-center gap-3 mb-4">
          <img src="/logo-dtoolkit.png" alt="" class="h-8 w-8" />
          <span class="font-bold text-lg">dtoolkit</span>
        </div>
        <p class="text-sm text-[var(--text-3)] leading-relaxed">
          Open-source harness engineering toolkit for AI coding agents.
        </p>
        <p class="text-xs text-[var(--text-3)] mt-2">MIT Licensed</p>
      </div>

      <div>
        <h4 class="font-semibold text-sm mb-4">Core Packages</h4>
        <ul class="space-y-2">
          <li><a href="https://www.npmjs.com/package/@dtoolkit/dbrain" target="_blank" rel="noopener noreferrer" class={footerLink}>@dtoolkit/dbrain</a></li>
          <li><a href="https://www.npmjs.com/package/@dtoolkit/dcontext" target="_blank" rel="noopener noreferrer" class={footerLink}>@dtoolkit/dcontext</a></li>
          <li><a href="https://www.npmjs.com/package/@dtoolkit/dproxy" target="_blank" rel="noopener noreferrer" class={footerLink}>@dtoolkit/dproxy</a></li>
          <li><a href="https://www.npmjs.com/package/@dtoolkit/dwork" target="_blank" rel="noopener noreferrer" class={footerLink}>@dtoolkit/dwork</a></li>
          <li><a href="https://www.npmjs.com/package/@dtoolkit/sdk" target="_blank" rel="noopener noreferrer" class={footerLink}>@dtoolkit/sdk</a></li>
        </ul>
      </div>

      <div>
        <h4 class="font-semibold text-sm mb-4">Resources</h4>
        <ul class="space-y-2">
          <li><a href="https://github.com/ivncmp/dtoolkit" target="_blank" rel="noopener noreferrer" class={footerLink}>GitHub Repository</a></li>
          <li><a href="https://www.npmjs.com/org/dtoolkit" target="_blank" rel="noopener noreferrer" class={footerLink}>npm Organization</a></li>
          <li><a href="https://github.com/ivncmp/dtoolkit/issues" target="_blank" rel="noopener noreferrer" class={footerLink}>Report Issues</a></li>
          <li><a href="https://github.com/ivncmp/dtoolkit/blob/main/LICENSE" target="_blank" rel="noopener noreferrer" class={footerLink}>MIT License</a></li>
        </ul>
      </div>

      <div>
        <h4 class="font-semibold text-sm mb-4">Team Packages</h4>
        <ul class="space-y-2">
          <li><a href="https://www.npmjs.com/package/@dtoolkit/dcouncil" target="_blank" rel="noopener noreferrer" class={footerLink}>@dtoolkit/dcouncil</a></li>
          <li><a href="https://www.npmjs.com/package/@dtoolkit/dguard" target="_blank" rel="noopener noreferrer" class={footerLink}>@dtoolkit/dguard</a></li>
          <li><a href="https://www.npmjs.com/package/@dtoolkit/dops" target="_blank" rel="noopener noreferrer" class={footerLink}>@dtoolkit/dops</a></li>
          <li><a href="https://www.npmjs.com/package/@dtoolkit/dpair" target="_blank" rel="noopener noreferrer" class={footerLink}>@dtoolkit/dpair</a></li>
          <li><a href="https://www.npmjs.com/package/@dtoolkit/dreplay" target="_blank" rel="noopener noreferrer" class={footerLink}>@dtoolkit/dreplay</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-12 pt-8 border-t border-[var(--border-subtle)] flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-sm text-[var(--text-3)]">
        Built by <a href="https://github.com/ivncmp" target="_blank" rel="noopener noreferrer" class="text-[var(--text-2)] hover:text-brand-purple transition-colors">Iván Campillo</a>
      </p>
      <div class="flex items-center gap-4">
        <a href="https://github.com/ivncmp/dtoolkit" target="_blank" rel="noopener noreferrer" class="text-[var(--text-3)] hover:text-[var(--text-2)] transition-colors" aria-label="GitHub">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
        </a>
        <a href="https://www.npmjs.com/org/dtoolkit" target="_blank" rel="noopener noreferrer" class="text-[var(--text-3)] hover:text-[var(--text-2)] transition-colors" aria-label="npm">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M1.763 0C.786 0 0 .786 0 1.763v20.474C0 23.214.786 24 1.763 24h20.474c.977 0 1.763-.786 1.763-1.763V1.763C24 .786 23.214 0 22.237 0zM5.13 5.323l13.837.019-.009 13.836h-3.464l.01-10.382h-3.456L12.04 19.17H5.113z"/></svg>
        </a>
      </div>
    </div>
  </div>
</footer>
