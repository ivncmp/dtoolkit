---
import Terminal from './Terminal.astro';

const heroCode = [
  '<span class="prompt">$</span> npm install -g <span class="string">@dtoolkit/dbrain</span> <span class="string">@dtoolkit/dcontext</span>',
  '',
  '<span class="prompt">$</span> dbrain init',
  '<span class="output">✓ Brain initialized at ~/.dbrain</span>',
  '<span class="output">✓ MCP server ready on :7878</span>',
  '',
  '<span class="prompt">$</span> dcontext install',
  '<span class="output">✓ Hooks installed for Claude Code</span>',
  '<span class="output">✓ Identity + project facts injected at session start</span>',
].join('\n');
---

<section class="relative pt-32 pb-24 pattern-bg">
  <div class="hero-glow"></div>

  <div class="relative z-10 max-w-5xl mx-auto px-6 text-center">
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-brand-purple/5 border border-brand-purple/10 mb-8">
      <span class="w-2 h-2 rounded-full bg-brand-purple animate-pulse"></span>
      <span class="text-sm text-brand-purple font-medium">20 packages &middot; MIT licensed</span>
    </div>

    <h1 class="text-5xl sm:text-6xl md:text-7xl font-black tracking-tight leading-[1.05]">
      Engineer your
      <br />
      <span class="gradient-text">AI agents</span>
    </h1>

    <p class="mt-6 text-lg sm:text-xl text-[var(--text-3)] max-w-2xl mx-auto leading-relaxed">
      Open-source harness engineering toolkit. Memory, context, routing, observability and project management — everything your coding agents need to work smarter.
    </p>

    <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
      <a
        href="#quickstart"
        class="inline-flex items-center gap-2 px-7 py-3.5 rounded-xl bg-brand-purple text-white font-semibold hover:bg-brand-purple-dark transition-colors shadow-lg shadow-brand-purple/25"
      >
        Get Started
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
      </a>
      <a
        href="#ecosystem"
        class="inline-flex items-center gap-2 px-7 py-3.5 rounded-xl border border-[var(--border)] text-[var(--text)] font-semibold hover:border-[var(--border-subtle)] hover:bg-[var(--surface)] transition-colors"
      >
        Explore Ecosystem
      </a>
    </div>

    <div class="mt-16 max-w-xl mx-auto text-left">
      <Terminal code={heroCode} />
    </div>
  </div>
</section>
