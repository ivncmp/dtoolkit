---

---

<section class="relative pt-32 pb-24 pattern-bg">
  <div class="hero-bg"></div>
  <div class="hero-glow"></div>

  <div class="relative z-10 max-w-5xl mx-auto px-6 text-center">
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-brand-purple/5 border border-brand-purple/10 mb-8">
      <span class="w-2 h-2 rounded-full bg-brand-purple animate-pulse"></span>
      <span class="text-sm text-brand-purple font-medium">20 packages &middot; 12 on npm &middot; MIT licensed</span>
    </div>

    <h1 class="text-5xl sm:text-6xl md:text-7xl font-black tracking-tight leading-[1.05]">
      Give your AI agents
      <br />
      <span class="gradient-text">memory, context &amp; eyes</span>
    </h1>

    <p class="mt-6 text-lg sm:text-xl text-[var(--text-3)] max-w-2xl mx-auto leading-relaxed">
      Open-source toolkit for AI coding agents. Persistent memory, automatic context injection, multi-provider transport, project management, and observability — everything your harness needs.
    </p>

    <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
      <a
        href="#quickstart"
        class="group inline-flex items-center gap-2 px-7 py-3.5 rounded-xl bg-brand-purple text-white font-semibold hover:bg-brand-purple-dark transition-all shadow-lg shadow-brand-purple/25 hover:shadow-xl hover:shadow-brand-purple/30 hover:-translate-y-0.5"
      >
        Get Started
        <svg class="w-4 h-4 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
      </a>
      <a
        href="/docs/guides/introduction/"
        class="inline-flex items-center gap-2 px-7 py-3.5 rounded-xl border border-[var(--border)] text-[var(--text)] font-semibold hover:border-brand-purple/30 hover:bg-[var(--surface)] transition-all"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
        Read the Docs
      </a>
    </div>

    <!-- Product logos strip -->
    <div class="mt-14 flex items-center justify-center gap-10">
      <a href="#dbrain" class="flex items-center gap-2.5 opacity-60 hover:opacity-100 transition-opacity">
        <img src="/logos/logo-dbrain.png" alt="dbrain" class="w-9 h-9" />
        <span class="text-xs font-mono font-semibold text-[var(--text-3)]">dbrain</span>
      </a>
      <a href="#dwork" class="flex items-center gap-2.5 opacity-60 hover:opacity-100 transition-opacity">
        <img src="/logos/logo-dwork.png" alt="dwork" class="w-9 h-9" />
        <span class="text-xs font-mono font-semibold text-[var(--text-3)]">dwork</span>
      </a>
      <a href="#dops" class="flex items-center gap-2.5 opacity-60 hover:opacity-100 transition-opacity">
        <img src="/logos/logo-dops.png" alt="dops" class="w-9 h-9" />
        <span class="text-xs font-mono font-semibold text-[var(--text-3)]">dops</span>
      </a>
    </div>
  </div>
</section>
