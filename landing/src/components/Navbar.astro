---
const products = [
  { label: 'dbrain', href: '#dbrain' },
  { label: 'dwork', href: '#dwork' },
  { label: 'dops', href: '#dops' },
  { label: 'dcontext', href: '#dcontext' },
  { label: 'dproxy', href: '#dproxy' },
];
const sections = [
  { label: 'ecosystem', href: '#ecosystem', section: 'ecosystem' },
  { label: 'quick start', href: '#quickstart', section: 'quickstart' },
  { label: 'documentation', href: '#documentation', section: 'documentation' },
];
---

<nav class="fixed top-0 w-full z-50 backdrop-blur-xl border-b border-[var(--border-subtle)]" style="background:oklch(from var(--bg) l c h / .88)" aria-label="Main navigation">
  <div class="max-w-7xl mx-auto px-6 h-14 flex items-center justify-between">
    <a href="#" class="flex items-center gap-1 group" aria-label="dtoolkit home">
      <img src="/logos/logo-dtoolkit.png" alt="" class="h-9 w-9 transition-transform group-hover:scale-105" />
      <span class="font-black text-lg tracking-tight">dtoolkit</span>
    </a>

    <div class="hidden lg:flex items-center">
      <div class="flex items-center gap-1 px-2 py-1 rounded-lg bg-[var(--surface-2)]/60">
        {products.map(({ label, href }) => (
          <a href={href} class="nav-link px-3 py-1.5 rounded-md text-xs font-mono font-semibold text-[var(--text-2)] hover:text-brand-purple hover:bg-[var(--surface)] transition-all" data-section={label}>
            {label}
          </a>
        ))}
      </div>

      <span class="mx-4 w-px h-4 bg-[var(--border)]"></span>

      {sections.map(({ label, href, section }) => (
        <a href={href} class="nav-link px-3 py-1.5 text-sm text-[var(--text-3)] hover:text-[var(--text)] transition-colors font-medium" data-section={section} {...(href.startsWith('http') && { target: '_blank', rel: 'noopener noreferrer' })}>
          {label}
        </a>
      ))}
    </div>

    <div class="flex items-center gap-3">
      <a
        href="https://www.npmjs.com/org/dtoolkit"
        target="_blank"
        rel="noopener noreferrer"
        class="text-xs font-mono text-[var(--text-3)] hover:text-[var(--text)] transition-colors hidden sm:block"
      >
        npm
      </a>
      <a
        href="https://github.com/ivncmp/dtoolkit"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-lg bg-[var(--text)] text-[var(--surface)] text-sm font-medium hover:opacity-90 transition-opacity"
      >
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
        <span class="hidden sm:inline">GitHub</span>
      </a>

      <!-- Mobile hamburger -->
      <button id="mobile-menu-btn" class="lg:hidden p-2 -mr-2 text-[var(--text-2)]" aria-label="Menu">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-[var(--border-subtle)] px-6 py-4" style="background:var(--bg)">
    <div class="flex flex-wrap gap-2 mb-3">
      {products.map(({ label, href }) => (
        <a href={href} class="mobile-nav-link px-3 py-1.5 rounded-md text-xs font-mono font-semibold text-[var(--text-2)] bg-[var(--surface-2)] hover:text-brand-purple transition-colors">
          {label}
        </a>
      ))}
    </div>
    <div class="flex gap-4 pt-2 border-t border-[var(--border-subtle)]">
      {sections.map(({ label, href }) => (
        <a href={href} class="mobile-nav-link text-sm text-[var(--text-3)] hover:text-[var(--text)] transition-colors font-medium" {...(href.startsWith('http') && { target: '_blank', rel: 'noopener noreferrer' })}>
          {label}
        </a>
      ))}
    </div>
  </div>
</nav>

<style>
  .nav-link.active {
    color: var(--accent);
    background: oklch(from var(--accent) l c h / .08);
  }
</style>

<script>
  const sections = document.querySelectorAll('section[id]');
  const links = document.querySelectorAll('.nav-link[data-section]');

  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          const id = entry.target.id;
          links.forEach((link) => {
            link.classList.toggle('active', link.getAttribute('data-section') === id);
          });
        }
      }
    },
    { rootMargin: '-40% 0px -55% 0px' }
  );

  sections.forEach((s) => observer.observe(s));

  // Mobile menu toggle
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => menu?.classList.toggle('hidden'));

  // Close mobile menu on link click
  document.querySelectorAll('.mobile-nav-link').forEach((link) => {
    link.addEventListener('click', () => menu?.classList.add('hidden'));
  });
</script>
