---
import Terminal from './Terminal.astro';

const step1Code = [
  '<span class="prompt">$</span> npm install -g \\',
  '    <span class="string">@dtoolkit/dbrain</span> \\',
  '    <span class="string">@dtoolkit/dcontext</span> \\',
  '    <span class="string">@dtoolkit/dwork</span> \\',
  '    <span class="string">@dtoolkit/dops</span> \\',
  '    <span class="string">@dtoolkit/dproxy</span>',
].join('\n');

const step2Code = [
  '<span class="prompt">$</span> dbrain init && dbrain start',
  '<span class="output">✓ API on :7878 — Dashboard on :7879</span>',
  '',
  '<span class="prompt">$</span> dbrain connect claude',
  '<span class="output">✓ MCP configured — CLAUDE.md written</span>',
].join('\n');

const step3Code = [
  '<span class="prompt">$</span> dcontext init',
  '<span class="output">✓ Connected to dbrain</span>',
  '',
  '<span class="prompt">$</span> dcontext install claude',
  '<span class="output">✓ Hooks installed</span>',
].join('\n');

const step4Code = [
  '<span class="prompt">$</span> dwork init && dwork start',
  '<span class="output">✓ API on :7881 — Dashboard on :7882</span>',
  '',
  '<span class="prompt">$</span> dops init && dops start',
  '<span class="output">✓ API on :7883 — Dashboard on :7884</span>',
  '',
  '<span class="prompt">$</span> dproxy init',
  '<span class="output">✓ Default provider: claude</span>',
].join('\n');

const step5Code = [
  '<span class="prompt">$</span> claude',
  '<span class="output">✓ Memory · Context · Tasks</span>',
  '<span class="output">  Observability · Multi-model</span>',
].join('\n');

const steps = [
  { step: '1', title: 'Install', description: 'All 5 products, one command.', code: step1Code },
  { step: '2', title: 'Memory', description: 'Create a brain, start the server, connect your CLI.', code: step2Code },
  { step: '3', title: 'Context', description: 'Automatic identity and project facts at every session.', code: step3Code },
  { step: '4', title: 'The rest', description: 'Project management, observability, multi-provider.', code: step4Code },
  { step: '5', title: 'Build', description: 'Open your CLI. The full harness is active.', code: step5Code },
];
---

<section id="quickstart" class="py-24 bg-[var(--surface-2)] pattern-diagonal">
  <div class="max-w-3xl mx-auto px-6">
    <div class="text-center mb-16 reveal">
      <h2 class="text-4xl sm:text-5xl font-black tracking-tight">
        Full environment in
        <span class="gradient-text">5 steps</span>
      </h2>
      <p class="mt-4 text-lg text-[var(--text-3)]">
        From zero to a fully instrumented AI coding harness.
      </p>
    </div>

    <div class="space-y-2">
      {steps.map((step) => (
        <div class="flex gap-5 reveal">
          <div class="flex-shrink-0 flex flex-col items-center">
            <div class="w-9 h-9 rounded-full bg-brand-purple text-white flex items-center justify-center font-bold text-sm">
              {step.step}
            </div>
            {step.step !== '5' && (
              <div class="w-px flex-1 bg-brand-purple/20 mt-1"></div>
            )}
          </div>
          <div class="flex-1 pb-6">
            <h3 class="text-lg font-bold mb-0.5">{step.title}</h3>
            <p class="text-sm text-[var(--text-3)] mb-3">{step.description}</p>
            <Terminal code={step.code} />
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
