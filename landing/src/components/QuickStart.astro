---
import Terminal from './Terminal.astro';

const step1Code = [
  '<span class="prompt">$</span> npm install -g <span class="string">@dtoolkit/dbrain</span>',
  '<span class="prompt">$</span> dbrain init',
  '<span class="output">✓ Brain created at ~/.dbrain</span>',
  '',
  '<span class="prompt">$</span> dbrain start',
  '<span class="output">✓ API on :7878 — Dashboard on :7879</span>',
  '',
  '<span class="prompt">$</span> dbrain connect claude',
  '<span class="output">✓ MCP server configured</span>',
  '<span class="output">✓ Permissions added</span>',
].join('\n');

const step2Code = [
  '<span class="prompt">$</span> npm install -g <span class="string">@dtoolkit/dcontext</span>',
  '<span class="prompt">$</span> dcontext init',
  '<span class="output">? dbrain URL: http://localhost:7878</span>',
  '<span class="output">? Map this directory to entity: my-app</span>',
  '<span class="output">✓ Connected</span>',
  '',
  '<span class="prompt">$</span> dcontext install claude',
  '<span class="output">✓ Hook added to .claude/settings.json</span>',
].join('\n');

const step3Code = [
  '<span class="prompt">$</span> claude',
  '',
  '<span class="comment"># Every session starts with context from dbrain:</span>',
  '<span class="comment"># - Your identity and preferences</span>',
  '<span class="comment"># - Project-specific facts and decisions</span>',
  '<span class="comment"># - Access to recall/remember via MCP</span>',
  '',
  '<span class="output">✓ Session enriched by dbrain</span>',
].join('\n');

const extraCode = [
  '<span class="prompt">$</span> npm install -g <span class="string">@dtoolkit/dproxy</span> <span class="string">@dtoolkit/dwork</span>',
  '<span class="prompt">$</span> dproxy init   <span class="comment"># Multi-provider CLI</span>',
  '<span class="prompt">$</span> dwork init    <span class="comment"># Project management</span>',
].join('\n');

const steps = [
  { step: '1', title: 'Install & start dbrain', description: 'Install the memory server, create a brain, start the API, and connect your coding CLI.', code: step1Code },
  { step: '2', title: 'Set up dcontext', description: 'Connect to dbrain, map your project directory, and install hooks for automatic context injection.', code: step2Code },
  { step: '3', title: 'Start building', description: 'Open your coding CLI. Your agent now has persistent memory, knows your identity, and understands your projects.', code: step3Code },
];
---

<section id="quickstart" class="py-24">
  <div class="max-w-4xl mx-auto px-6">
    <div class="text-center mb-16 reveal">
      <h2 class="text-4xl sm:text-5xl font-black tracking-tight">
        Up and running in
        <span class="gradient-text">3 steps</span>
      </h2>
      <p class="mt-4 text-lg text-[var(--text-3)]">
        From zero to persistent AI memory in under two minutes.
      </p>
    </div>

    <div class="space-y-8">
      {steps.map((step) => (
        <div class="flex gap-6 reveal">
          <div class="flex-shrink-0">
            <div class="w-10 h-10 rounded-full bg-brand-purple text-white flex items-center justify-center font-bold text-sm">
              {step.step}
            </div>
            {step.step !== '3' && (
              <div class="w-px h-full bg-[var(--border)] mx-auto mt-2"></div>
            )}
          </div>
          <div class="flex-1 pb-8">
            <h3 class="text-xl font-bold mb-1">{step.title}</h3>
            <p class="text-[var(--text-3)] mb-4">{step.description}</p>
            <Terminal code={step.code} />
          </div>
        </div>
      ))}
    </div>

    <div class="mt-12 text-center">
      <p class="text-[var(--text-3)] text-sm mb-6">
        Want the full suite? Add dproxy for multi-model support, dwork for project management.
      </p>
      <div class="inline-block text-left">
        <Terminal code={extraCode} />
      </div>
    </div>
  </div>
</section>
