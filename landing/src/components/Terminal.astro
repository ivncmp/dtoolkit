---
interface Props {
  title?: string;
  code: string;
}

const { title = 'terminal', code } = Astro.props;
---

<div class="code-block">
  <div class="flex items-center gap-2 mb-4 pb-3 border-b border-gray-800">
    <div class="w-3 h-3 rounded-full bg-red-500/80"></div>
    <div class="w-3 h-3 rounded-full bg-yellow-500/80"></div>
    <div class="w-3 h-3 rounded-full bg-green-500/80"></div>
    <span class="ml-2 text-xs text-gray-500">{title}</span>
  </div>
  <pre class="!m-0 !p-0 !bg-transparent !rounded-none !overflow-visible text-sm leading-relaxed" set:html={code} />
</div>
