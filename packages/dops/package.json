{
  "name": "@dtoolkit/dops",
  "version": "0.1.1",
  "description": "Agent observability — tokens, cost, tools, success rate, errors. Part of the dtoolkit suite.",
  "type": "module",
  "license": "MIT",
  "author": "Iván Campillo <ivncmp@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ivncmp/dtoolkit.git",
    "directory": "packages/dops"
  },
  "homepage": "https://github.com/ivncmp/dtoolkit/tree/main/packages/dops",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "dops": "dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "ai",
    "observability",
    "metrics",
    "tokens",
    "cost",
    "dtoolkit"
  ],
  "scripts": {
    "dev": "tsx watch src/cli/index.ts start",
    "cli": "tsx src/cli/index.ts",
    "build": "tsc && mkdir -p dist/dashboard && cp src/dashboard/index.html src/dashboard/logo*.png dist/dashboard/ && chmod +x dist/cli/index.js",
    "start": "node dist/cli/index.js start",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@clack/prompts": "^1.3.0",
    "@dtoolkit/adapter-claude": "workspace:*",
    "@dtoolkit/adapter-codex": "workspace:*",
    "@dtoolkit/adapter-gemini": "workspace:*",
    "@dtoolkit/adapter-opencode": "workspace:*",
    "@dtoolkit/core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^12.9.0",
    "commander": "^13.1.0",
    "fastify": "^5.8.5",
    "picocolors": "^1.1.1",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.6.0",
    "tsx": "^4.21.0",
    "vitest": "^4.1.5"
  }
}
